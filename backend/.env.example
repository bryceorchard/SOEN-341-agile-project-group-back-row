# Copy to .env and fill in; .env is gitignored and never committed.

# JWT_SECRET=
# CORS_ORIGIN=http://localhost:4200
# DB_PATH=
# UPLOAD_DIR=

# AI resume feedback (#139). See docs/ai/us10-resume-feedback.md for the provider
# recommendation (Groq, free plan). Without a key, set AI_PROVIDER=mock to get a fixed sample
# reply instead of calling out (the tests do this themselves). With neither, the feedback
# endpoint returns 503 instead of fake feedback.
# AI_API_KEY=
# AI_PROVIDER=mock
# AI_MODEL=openai/gpt-oss-120b
# AI_BASE_URL=https://api.groq.com/openai/v1
