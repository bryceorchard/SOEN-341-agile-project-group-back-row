# Copy to .env and fill in; .env is gitignored and never committed.

# JWT_SECRET=
# CORS_ORIGIN=http://localhost:4200
# DB_PATH=
# UPLOAD_DIR=

# AI resume feedback (#139). Leave AI_API_KEY unset in development and CI: the backend
# then uses a deterministic mock reply instead of calling out. See
# docs/ai/us10-resume-feedback.md for the provider recommendation (Groq, free plan).
# AI_API_KEY=
# AI_MODEL=openai/gpt-oss-120b
# AI_BASE_URL=https://api.groq.com/openai/v1
